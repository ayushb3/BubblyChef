# BubblyChef AI Microservice — Environment Variables
# Copy this to .env and fill in your values.

# =============================================================================
# Supabase (required)
# =============================================================================
# Get these from: supabase.com → your project → Settings → API
BUBBLY_SUPABASE_URL=https://your-project.supabase.co
BUBBLY_SUPABASE_SECRET_KEY=your-secret-key

# JWT secret for validating user tokens forwarded from the Next.js frontend.
# Get from: Settings → API → JWT Settings → JWT Secret
BUBBLY_SUPABASE_JWT_SECRET=your-jwt-secret

# =============================================================================
# AI Providers (at least one required)
# =============================================================================

# Gemini (Recommended - Free Tier)
# Get your key at: https://aistudio.google.com/
BUBBLY_GEMINI_API_KEY=your-gemini-api-key
BUBBLY_GEMINI_MODEL=gemini-2.5-flash

# Ollama (Self-hosted - Optional fallback)
# Install: https://ollama.ai/
BUBBLY_OLLAMA_BASE_URL=http://localhost:11434
BUBBLY_OLLAMA_MODEL=llama3.2:3b

# =============================================================================
# CORS (required)
# =============================================================================
# Frontend URLs allowed to call this service directly (SSE streaming).
# In production, set to your Vercel domain.
BUBBLY_CORS_ORIGINS=["http://localhost:3000"]

# =============================================================================
# Receipt Scanning
# =============================================================================
BUBBLY_AUTO_ADD_CONFIDENCE_THRESHOLD=0.8
BUBBLY_REVIEW_CONFIDENCE_THRESHOLD=0.5

# =============================================================================
# Testing
# =============================================================================
# Set to 1 to run live AI API tests (requires BUBBLY_GEMINI_API_KEY)
# Used by: tests/test_intent_live.py
BUBBLY_RUN_LIVE_TESTS=0
