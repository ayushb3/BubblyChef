{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "uvicorn bubbly_chef.main:app --host 0.0.0.0 --port 8888",
    "healthcheckPath": "/health/ai",
    "restartPolicyType": "ON_FAILURE"
  }
}
