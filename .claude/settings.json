{
  "permissions": {
    "allow": [
      "Bash(docker-compose -f docker-compose.sandbox.yml config --quiet)",
      "Bash(ls -lh /Users/I589687/Personal/BubblyChef/docs/WORKFLOW*.md)",
      "Bash(curl -s http://localhost:8888/health)"
    ],
    "deny": [
      "Read(docs/archive/**)",
      "Read(docs/archive)"
    ]
  },
  "plansDirectory": "docs/plans",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pr-review-gate.sh\"",
            "timeout": 10,
            "statusMessage": "Checking review gate before PR..."
          }
        ]
      },
      {
        "matcher": "mcp__github__create_pull_request|mcp__github__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pr-review-gate.sh\"",
            "timeout": 10,
            "statusMessage": "Checking review gate before PR..."
          }
        ]
      }
    ]
  }
}
