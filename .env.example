# BubblyChef Environment Configuration
#
# Architecture: Next.js (Vercel) + Supabase + FastAPI AI Microservice (Railway)
# See docs/ARCHITECTURE.md for details.

# =============================================================================
# Next.js Frontend + CRUD API (nextjs/.env.local)
# =============================================================================
# Copy these to nextjs/.env.local

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_...your-publishable-key
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8888

# =============================================================================
# AI Microservice (ai-service/.env)
# =============================================================================
# Copy these to ai-service/.env

# Supabase (required)
BUBBLY_SUPABASE_URL=https://your-project.supabase.co
BUBBLY_SUPABASE_SECRET_KEY=sb_secret_...your-secret-key
BUBBLY_SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-settings

# AI Providers (at least one required)
# Gemini (Recommended - Free Tier) — get key at https://aistudio.google.com/
BUBBLY_GEMINI_API_KEY=your-gemini-api-key-here
BUBBLY_GEMINI_MODEL=gemini-2.5-flash

# Ollama (Self-hosted - Optional) — install at https://ollama.ai/
BUBBLY_OLLAMA_BASE_URL=http://localhost:11434
BUBBLY_OLLAMA_MODEL=llama3.2:3b

# CORS origins (frontend URLs allowed to call the AI service)
BUBBLY_CORS_ORIGINS=["http://localhost:3000"]

# Receipt scanning confidence thresholds
BUBBLY_AUTO_ADD_CONFIDENCE_THRESHOLD=0.8
BUBBLY_REVIEW_CONFIDENCE_THRESHOLD=0.5

# =============================================================================
# Where to get Supabase keys
# =============================================================================
# 1. Go to supabase.com → your project → Settings → API
# 2. Project URL           → NEXT_PUBLIC_SUPABASE_URL / BUBBLY_SUPABASE_URL
# 3. Publishable key       → NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY (safe for browser)
# 4. Secret key            → SUPABASE_SECRET_KEY / BUBBLY_SUPABASE_SECRET_KEY (server-only!)
# 5. Settings → API → JWT Settings → JWT Secret → BUBBLY_SUPABASE_JWT_SECRET
#
# Note: Supabase also shows legacy "anon" and "service_role" keys — use the
# newer publishable/secret keys for new projects.
#
# See docs/SUPABASE_SETUP.md for full setup guide.
